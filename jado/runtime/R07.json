        ]
      },
      {
        "id": "canvas_check-canvas_review",
        "from": "canvas_check",
        "to": "canvas_review",
        "label": "Independent review"
      },
      {
        "id": "canvas_review-canvas_gate",
        "from": "canvas_review",
        "to": "canvas_gate",
        "label": ""
      },
      {
        "id": "canvas_gate-code_scope",
        "from": "canvas_gate",
