  "workflow": {
    "id": "R04",
    "title": "R04 · Build",
    "summary": "Implement an approved direction or a selected canvas in code and verify it at the stage's rigor.",
    "notes": "Refine verifies the affected states with a self-check and adds an independent review when the budget is normal or deep. Ship always requires the independent visual review, plus UX review when critical flows or states change. Engineering work only for a concrete technical problem. Repairs return to the same builder as one aggregated batch.",
    "kind": "workflow",
    "surface": "code",
    "stages": [
      "refine",
      "ship"
    ],
    "status": "proposed",
    "lastReviewed": "2026-10-06",
    "stage": "operations",
    "inputs": [
      "Approved direction or selected canvas, and the authorization to implement"
    ],
    "outputs": [
      "Implementation with current evidence and completed checks"
    ],
    "budget": {
      "newDelegations": 4,
      "concurrent": 2,
      "repairBatches": 2
    },
    "entry": "p",
    "requiredNodes": [],
    "nodes": [
      {
        "id": "p",
        "kind": "start",
        "label": "Read the approved source",
        "detail": "Identify the approved direction or selected canvas revision and the decision that authorizes implementation."
      },
      {
        "id": "ready",
        "kind": "decision",
        "label": "Is the source complete and approved?",
        "detail": "Check completeness and the authorization."
      },
      {
        "id": "canvas",
        "kind": "action",
        "label": "Read the selected canvas",
        "detail": "Read tree, tokens, text and captures of the selected revision."
      },
      {
        "id": "map",
        "kind": "skill",
        "label": "Map tokens and components",
        "detail": "Map canvas decisions to existing tokens and component APIs.",
        "ref": "jado-design-systems"
      },
      {
        "id": "b",
        "kind": "skill",
        "label": "Implement components and states",
        "detail": "Use project tokens and components within scope; explain responsive adaptations.",
        "ref": "jado-ui-builder"
      },
      {
        "id": "proof",
        "kind": "action",
        "label": "Capture current browser evidence",
        "detail": "Capture the current revision at target viewports and states; exercise keyboard and behavior that captures cannot prove."
      },
      {
        "id": "risk",
        "kind": "decision",
        "label": "Is there a concrete technical problem?",
        "detail": "A completed intervention does not reopen this branch."
      },
      {
        "id": "eng",
        "kind": "skill",
        "label": "Resolve the technical problem",
        "detail": "Fix only the assigned issue and recapture.",
        "ref": "jado-ui-engineer"
      },
      {
        "id": "check",
        "kind": "decision",
        "label": "Does the stage need an independent review?",
        "detail": "Ship: always. Refine: when the budget is normal or deep."
      },
      {
        "id": "rev",
        "kind": "skill",
        "label": "Review visual output",
        "detail": "Check rendering and fidelity read-only against the source.",
        "ref": "jado-visual-reviewer"
      },
      {
        "id": "ux",
        "kind": "skill",
        "label": "Review critical flows and states",
        "detail": "Check changed critical flows and states read-only.",
        "ref": "jado-ux-reviewer"
      },
      {
        "id": "parent",
        "kind": "action",
        "label": "Aggregate findings",
        "detail": "Deduplicate findings into one repair batch; drop findings outside scope or stage."
      },
      {
        "id": "gate",
        "kind": "gate",
        "label": "Did the required checks pass?",
        "detail": "Verify completed checks against current evidence."
      },
      {
        "id": "done",
        "kind": "end",
        "label": "Deliver verified implementation",
        "detail": "Return implementation, passed checks and stated limits."
      },
      {
        "id": "stop",
        "kind": "end",
        "label": "Report partial or blocked work",
        "detail": "Identify unverified parts, the missing source or the budget block."
      }
    ],
